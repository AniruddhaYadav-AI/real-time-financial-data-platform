# Application Configuration
APP_NAME="Financial Data Platform"
APP_ENV=development
DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=financial_data
LOG_LEVEL="INFO"

# Server Configuration
HOST="127.0.0.1"
PORT=8000

# ── Kafka / Redpanda ─────────────────────────────────────────────────────────
# Bootstrap server for the local development Redpanda broker.
# Uses the external listener port (19092) for host → Docker connectivity.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Topics
KAFKA_TRADE_TOPIC=market.trades.raw
KAFKA_DLQ_TOPIC=dlq.market.trades

# Topic partition counts (development-only values; production determined by load testing)
KAFKA_TRADE_TOPIC_PARTITIONS=3
KAFKA_DLQ_TOPIC_PARTITIONS=1

# Consumer group
KAFKA_CONSUMER_GROUP_ID=trade-processor

# Producer settings
KAFKA_ACKS=all
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_DELIVERY_TIMEOUT_MS=120000

# Consumer settings
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_MAX_POLL_INTERVAL_MS=300000
